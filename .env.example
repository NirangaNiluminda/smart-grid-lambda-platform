# Copy to `.env` (git-ignored) and adjust as needed. Every service reads its
# configuration from the environment; this file is the authoritative list of
# knobs. See docs/DATA_CONTRACTS.md for the meaning of each value.

# ----------------------------------------------------------------------------
# Simulated clock  (shared by meter-simulator and batch-file-generator)
# ----------------------------------------------------------------------------
# One simulated business day is compressed into this many wall-clock seconds.
SIM_DAY_SECONDS=600
# Wall-clock instant that maps to simulated 1970-01-01T00:00:00Z. Leave blank to
# anchor on process start (each `docker compose up` starts a fresh simulated day 0).
SIM_EPOCH_WALLCLOCK=
# Simulated calendar date that the simulation starts on.
SIM_START_DATE=2026-01-01

# ----------------------------------------------------------------------------
# Kafka
# ----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_READINGS_TOPIC=meter.readings
KAFKA_READINGS_DLQ_TOPIC=meter.readings.dlq
KAFKA_READINGS_PARTITIONS=6
KAFKA_CONSUMER_GROUP_INGESTION=ingestion-raw-lake
KAFKA_CONSUMER_GROUP_STREAM=stream-processor-speed-layer

# ----------------------------------------------------------------------------
# Postgres  (serving + Airflow metadata use separate databases on one instance)
# ----------------------------------------------------------------------------
PG_HOST=postgres
PG_PORT=5432
# Host-side port compose maps to Postgres's 5432. Only change this if 5432 is
# already taken on your machine (e.g. another project's Postgres) -- it does
# not affect PG_DSN, which containers reach over the compose network.
PG_HOST_PORT=5432
PG_USER=energy
PG_PASSWORD=energy
PG_DATABASE=energy_serving
PG_DSN=postgresql://energy:energy@postgres:5432/energy_serving
# Read-only role serving-api and Grafana connect as (granted in
# infra/postgres/init/004_serving_ro_grants.sql). `make test-integration` runs
# from the host, not a container, so it defaults to localhost if this is unset.
PG_DSN_SERVING_RO=postgresql://serving_ro:serving_ro@postgres:5432/energy_serving

# ----------------------------------------------------------------------------
# Data lake (immutable master dataset for the Lambda batch layer)
# ----------------------------------------------------------------------------
LAKE_ROOT=/data/lake
LANDING_ROOT=/data/landing

# ----------------------------------------------------------------------------
# meter-simulator
# ----------------------------------------------------------------------------
SIM_HOUSEHOLD_COUNT=200
SIM_EMIT_INTERVAL_SECONDS=2
SIM_ANOMALY_RATE=0.02
SIM_SEED=42

# ----------------------------------------------------------------------------
# Observability
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_PORT=9101
# alert-engine thresholds (Part 2 consumes these)
ALERT_NO_DATA_MINUTES=3
ALERT_LOW_RENEWABLE_PCT=15
ALERT_MAX_REJECT_RATE=0.05
